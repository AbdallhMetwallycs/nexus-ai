{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NEXUS AI",
  "mainBinaryName": "NEXUS-AI",
  "version": "0.1.0",
  "identifier": "ai.nexus.local",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "NEXUS AI",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Offline-first local AI for Windows",
    "longDescription": "NEXUS AI runs a GGUF language model through a bundled llama.cpp engine on this PC. No account, no telemetry, no cloud calls. The first run downloads the model that fits this machine's RAM and verifies its SHA-256 before use.",
    "resources": {
      "resources/engine/": "engine/"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
